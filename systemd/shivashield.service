[Unit]
Description=ShivaShield XDP — Advanced XDP/eBPF Firewall
Documentation=https://github.com/shuvamraaz/shivashield-xdp
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=simple
ExecStartPre=-/usr/local/bin/shivashield unload
ExecStart=/usr/local/bin/shivashield load --no-tui --config /etc/shivashield/shivashield.yaml
ExecStop=/usr/local/bin/shivashield unload
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=1048576
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
