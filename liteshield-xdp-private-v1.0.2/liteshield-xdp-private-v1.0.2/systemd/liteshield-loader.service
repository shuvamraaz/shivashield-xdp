[Unit]
Description=LiteShield XDP - minimal XDP firewall loader
Documentation=https://github.com/AnAverageBeing/LiteShield-XDP
# Attach as early as possible, before networking is considered up.
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/liteshield load --no-tui --config /etc/liteshield/liteshield.yaml
ExecStop=/usr/local/bin/liteshield unload

[Install]
WantedBy=multi-user.target
